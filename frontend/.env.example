# Opciones del front (todas opcionales). Copiá este archivo como frontend/.env para cambiarlas.

# Base de la API. Por defecto se usa /api en el mismo dominio.
# VITE_API_BASE=/api

# A dónde reenvía /api el servidor de desarrollo de Vite.
# VITE_API_PROXY=http://127.0.0.1:8080

# Mail que muestran "Olvidé mi contraseña" y "Solicitar cuenta" en el login.
# VITE_SUPPORT_EMAIL=soporte@ejemplo.edu.ar
